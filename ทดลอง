<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>สถิติรถบรรทุกติดคิว - ครบุรี & สีคิ้ว</title>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chartjs-plugin-datalabels@2.2.0"></script>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/PapaParse/5.3.2/papaparse.min.js"></script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Sarabun:wght@300;400;600;700&display=swap');
        body { font-family: 'Sarabun', sans-serif; background-color: #f8fafc; }
        .chart-container { position: relative; height: 280px; width: 100%; }
        .summary-card { 
            background: white; 
            border-radius: 12px; 
            box-shadow: 0 4px 6px -1px rgba(0,0,0,0.1); 
            padding: 1.25rem; 
            border: 1px solid #e2e8f0; 
        }
    </style>
</head>
<body>
    <header class="bg-white border-b sticky top-0 z-50 shadow-sm">
        <div class="max-w-7xl mx-auto px-4 py-4 flex flex-col md:flex-row items-center justify-between gap-4">
            <h1 class="text-xl font-bold text-slate-800 flex items-center gap-2">
                <span class="text-2xl">🚛</span> ข้อมูลสถิติรถบรรทุกติดคิว ปี 68/69
            </h1>
            <div class="flex flex-wrap gap-2 items-center">
                <div class="flex gap-2">
                    <label class="cursor-pointer bg-green-600 text-white px-3 py-2 rounded-md text-xs font-medium hover:bg-green-700">
                        📁 อัปโหลดไฟล์ครบุรี
                        <input type="file" id="fileKHONBURI" class="hidden" accept=".csv">
                    </label>
                    <label class="cursor-pointer bg-indigo-600 text-white px-3 py-2 rounded-md text-xs font-medium hover:bg-indigo-700">
                        📁 อัปโหลดไฟล์สีคิ้ว
                        <input type="file" id="fileSIKHIO" class="hidden" accept=".csv">
                    </label>
                </div>
                <div class="h-8 w-px bg-slate-200 mx-2 hidden md:block"></div>
                <div class="flex items-center gap-2">
                    <span class="text-xs font-semibold text-slate-500 uppercase">วันที่ชั่งออก:</span>
                    <select id="dateFilter" disabled class="bg-white border border-slate-300 text-sm rounded-md p-2 outline-none min-w-[150px]">
                        <option value="">รอไฟล์ข้อมูล...</option>
                    </select>
                </div>
            </div>
        </div>
    </header>

    <main class="max-w-7xl mx-auto px-4 py-8">
        <div id="welcomeMessage" class="text-center py-24 bg-white rounded-3xl border-2 border-dashed border-slate-200">
            <div class="mb-4 text-5xl text-slate-300">📊</div>
            <p class="text-slate-500 text-lg font-medium">กรุณาอัปโหลดไฟล์ CSV เพื่อเริ่มต้น</p>
        </div>

        <div id="dashboardContent" class="hidden space-y-12">
            <section id="sectionKHONBURI" class="mb-12">
                <div class="flex items-center gap-3 mb-6">
                    <div class="w-2.5 h-10 bg-green-500 rounded-full"></div>
                    <h2 class="text-2xl font-bold text-slate-800">1) โรงงานครบุรี (KHONBURI)</h2>
                </div>
                <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                    <div class="summary-card" id="card-KHONBURIAll">
                        <h3 class="font-bold text-sky-950 text-center mb-4 text-lg">ภาพรวม</h3>
                        <div class="chart-container"><canvas id="chart-KHONBURIAll"></canvas></div>
                        <div class="stats-box mt-4 pt-4 space-y-2 bg-green-50 p-4 rounded-lg"></div>
                    </div>
                    <div class="summary-card" id="card-KHONBURIIn">
                        <h3 class="font-bold text-emerald-600 text-center mb-4 text-lg">ในเขต</h3>
                        <div class="chart-container"><canvas id="chart-KHONBURIIn"></canvas></div>
                        <div class="stats-box mt-4 pt-4 space-y-2 bg-green-50 p-4 rounded-lg"></div>
                    </div>
                    <div class="summary-card" id="card-KHONBURIOut">
                        <h3 class="font-bold text-orange-600 text-center mb-4 text-lg">นอกเขต</h3>
                        <div class="chart-container"><canvas id="chart-KHONBURIOut"></canvas></div>
                        <div class="stats-box mt-4 pt-4 space-y-2 bg-green-50 p-4 rounded-lg"></div>
                    </div>
                </div>
            </section>

            <section id="sectionSIKHIO">
                <div class="flex items-center gap-3 mb-6">
                    <div class="w-2.5 h-10 bg-indigo-500 rounded-full"></div>
                    <h2 class="text-2xl font-bold text-slate-800">2) โรงงานสีคิ้ว (SIKHIO)</h2>
                </div>
                <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                    <div class="summary-card" id="card-SIKHIOAll">
                        <h3 class="font-bold text-sky-950 text-center mb-4 text-lg">ภาพรวม</h3>
                        <div class="chart-container"><canvas id="chart-SIKHIOAll"></canvas></div>
                        <div class="stats-box mt-4 pt-4 space-y-2 bg-cyan-50 p-4 rounded-lg"></div>
                    </div>
                    <div class="summary-card" id="card-SIKHIOIn">
                        <h3 class="font-bold text-emerald-600 text-center mb-4 text-lg">ในเขต</h3>
                        <div class="chart-container"><canvas id="chart-SIKHIOIn"></canvas></div>
                        <div class="stats-box mt-4 pt-4 space-y-2 bg-cyan-50 p-4 rounded-lg"></div>
                    </div>
                    <div class="summary-card" id="card-SIKHIOOut">
                        <h3 class="font-bold text-orange-600 text-center mb-4 text-lg">นอกเขต</h3>
                        <div class="chart-container"><canvas id="chart-SIKHIOOut"></canvas></div>
                        <div class="stats-box mt-4 pt-4 space-y-2 bg-cyan-50 p-4 rounded-lg"></div>
                    </div>
                </div>
            </section>
        </div>
    </main>

    <script>
        let rawData = { KHONBURI: [], SIKHIO: [] };
        let charts = {};

        const cleanKey = (key) => key ? key.trim() : '';

        document.getElementById('fileKHONBURI').addEventListener('change', (e) => handleFileUpload(e, 'KHONBURI'));
        document.getElementById('fileSIKHIO').addEventListener('change', (e) => handleFileUpload(e, 'SIKHIO'));
        document.getElementById('dateFilter').addEventListener('change', processAndRender);

        function handleFileUpload(event, type) {
            const file = event.target.files[0];
            if (!file) return;

            Papa.parse(file, {
                header: true,
                dynamicTyping: true,
                skipEmptyLines: true,
                complete: function(results) {
                    rawData[type] = results.data.map(row => {
                        let newRow = {};
                        Object.keys(row).forEach(k => newRow[cleanKey(k)] = row[k]);
                        return newRow;
                    });
                    updateDateFilter();
                    checkReadyState();
                }
            });
        }

        function updateDateFilter() {
            const allDates = new Set();
            [...rawData.KHONBURI, ...rawData.SIKHIO].forEach(row => {
                if (row['วันที่ชั่งออก']) allDates.add(row['วันที่ชั่งออก']);
            });
            const select = document.getElementById('dateFilter');
            const sortedDates = Array.from(allDates).sort().reverse();
            if (sortedDates.length > 0) {
                select.innerHTML = sortedDates.map(d => `<option value="${d}">${d}</option>`).join('');
                select.disabled = false;
                processAndRender();
            }
        }

        function checkReadyState() {
            if (rawData.KHONBURI.length > 0 || rawData.SIKHIO.length > 0) {
                document.getElementById('welcomeMessage').classList.add('hidden');
                document.getElementById('dashboardContent').classList.remove('hidden');
            }
        }

        function calculateStats(data) {
            const binSize = 6;
            const maxFixedRange = 60; 
            const numBins = maxFixedRange / binSize; 
            const bins = new Array(numBins).fill(0);
            const labels = [];

            for(let i=0; i<numBins; i++) {
                labels.push(`${i * binSize}-${(i + 1) * binSize}`);
            }

            if (!data || data.length === 0) {
                return { mean: 0, min: 0, max: 0, count: 0, bins, labels };
            }

            const hours = data.map(d => d['ชั่วโมงติดคิว']).filter(h => h != null && !isNaN(h));
            hours.forEach(h => {
                const binIdx = Math.floor(h / binSize);
                if (binIdx >= 0 && binIdx < numBins) {
                    bins[binIdx]++;
                } else if (binIdx >= numBins) {
                    bins[numBins - 1]++;
                }
            });

            return { 
                mean: hours.length > 0 ? hours.reduce((a, b) => a + b, 0) / hours.length : 0, 
                min: hours.length > 0 ? Math.min(...hours) : 0, 
                max: hours.length > 0 ? Math.max(...hours) : 0, 
                count: hours.length, 
                bins, 
                labels 
            };
        }

        function renderBarChart(canvasId, stats, color, dynamicYMax, yStep) {
            const ctx = document.getElementById(canvasId).getContext('2d');
            const cardId = canvasId.replace('chart-', 'card-');
            const statsBox = document.querySelector(`#${cardId} .stats-box`);
            
            if (charts[canvasId]) charts[canvasId].destroy();

            charts[canvasId] = new Chart(ctx, {
                type: 'bar',
                plugins: [ChartDataLabels],
                data: {
                    labels: stats.labels,
                    datasets: [{
                        data: stats.bins,
                        backgroundColor: color.replace('1)', '0.7)'),
                        borderColor: color,
                        borderWidth: 1,
                        borderRadius: 4
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { 
                        legend: { display: false },
                        datalabels: {
                            anchor: 'end',
                            align: 'top',
                            offset: -2,
                            formatter: (value) => value > 0 ? value.toLocaleString() : '',
                            font: { size: 9, weight: 'bold' },
                            color: color
                        },
                        tooltip: {
                            callbacks: {
                                label: (context) => ` จำนวนรถ: ${context.raw.toLocaleString()} คัน`
                            }
                        }
                    },
                    scales: {
                        y: { 
                            beginAtZero: true,
                            min: 0,
                            max: dynamicYMax,
                            title: {
                                display: true,
                                text: 'จำนวนรถบรรทุก (คัน)',
                                font: { size: 10, weight: 'normal' }
                            },
                            ticks: { 
                                stepSize: yStep,
                                precision: 0, 
                                font: { size: 9 },
                                callback: (value) => value.toLocaleString()
                            }
                        },
                        x: { 
                            title: {
                                display: true,
                                text: 'เวลาติดคิว (ชั่วโมง)',
                                font: { size: 10, weight: 'normal' }
                            },
                            ticks: { font: { size: 8 } }, 
                            grid: { display: false }
                        }
                    }
                }
            });

            if (stats.count > 0) {
                statsBox.innerHTML = `
                    <div class="flex justify-between items-center border-b border-slate-200/50 pb-1">
                        <span class="text-Base">เฉลี่ย:</span> 
                        <span class="text-Base font-bold text-slate-800">${stats.mean.toLocaleString(undefined, {minimumFractionDigits: 2, maximumFractionDigits: 2})} ชม.</span>
                    </div>
                    <div class="flex justify-between items-center border-b border-slate-200/50 pb-1">
                        <span class="text-sm">น้อยสุด:</span> 
                        <span class="text-sm font-bold text-emerald-500">${stats.min.toLocaleString(undefined, {minimumFractionDigits: 2, maximumFractionDigits: 2})} ชม.</span>
                    </div>
                    <div class="flex justify-between items-center border-b border-slate-200/50 pb-1">
                        <span class="text-sm">มากสุด:</span> 
                        <span class="text-sm font-bold text-rose-600">${stats.max.toLocaleString(undefined, {minimumFractionDigits: 2, maximumFractionDigits: 2})} ชม.</span>
                    </div>
                    <div class="flex justify-between items-center pt-1">
                        <span class="text-sm">รวม:</span> 
                        <span class="text-sm font-bold text-yellow-600">${stats.count.toLocaleString()} คัน</span>
                    </div>
                `;
            } else {
                statsBox.innerHTML = `<div class="text-center text-slate-400 py-1 italic">ไม่พบข้อมูลในกลุ่มนี้</div>`;
            }
        }

        function processAndRender() {
            const date = document.getElementById('dateFilter').value;
            if (!date) return;
            const filterByDate = (arr) => arr.filter(d => d['วันที่ชั่งออก'] === date);
            const cleanStatus = (status) => status ? status.trim() : '';

            // 1. เตรียมข้อมูล
            const kData = filterByDate(rawData.KHONBURI);
            const kStatsAll = calculateStats(kData);
            const kStatsIn = calculateStats(kData.filter(d => cleanStatus(d['สถานะเขต']) === 'ในเขต'));
            const kStatsOut = calculateStats(kData.filter(d => cleanStatus(d['สถานะเขต']) === 'นอกเขต'));

            const sData = filterByDate(rawData.SIKHIO);
            const sStatsAll = calculateStats(sData);
            const sStatsIn = calculateStats(sData.filter(d => cleanStatus(d['สถานะเขต']) === 'ในเขต'));
            const sStatsOut = calculateStats(sData.filter(d => cleanStatus(d['สถานะเขต']) === 'นอกเขต'));

            // 2. คำนวณหา Max สูงสุดของแต่ละโรงงานเพื่อ Lock สเกล
            const getGroupMax = (statsArray) => Math.max(...statsArray.flatMap(s => s.bins));
            
            // ครบุรี: Step 100, เผื่อไว้ 50 สำหรับตัวเลข Data Label
            const kMaxVal = getGroupMax([kStatsAll, kStatsIn, kStatsOut]);
            const kDynamicMax = Math.ceil((kMaxVal + 50) / 100) * 100;

            // สีคิ้ว: Step 50, เผื่อไว้ 25 สำหรับตัวเลข Data Label
            const sMaxVal = getGroupMax([sStatsAll, sStatsIn, sStatsOut]);
            const sDynamicMax = Math.ceil((sMaxVal + 25) / 50) * 50;

            const colors = { blue: 'rgba(2, 45, 90, 1)', green: 'rgba(5, 150, 105, 1)', orange: 'rgba(234, 88, 12, 1)' };

            // 3. เรนเดอร์กราฟ
            renderBarChart('chart-KHONBURIAll', kStatsAll, colors.blue, kDynamicMax, 100);
            renderBarChart('chart-KHONBURIIn', kStatsIn, colors.green, kDynamicMax, 100);
            renderBarChart('chart-KHONBURIOut', kStatsOut, colors.orange, kDynamicMax, 100);

            renderBarChart('chart-SIKHIOAll', sStatsAll, colors.blue, sDynamicMax, 50);
            renderBarChart('chart-SIKHIOIn', sStatsIn, colors.green, sDynamicMax, 50);
            renderBarChart('chart-SIKHIOOut', sStatsOut, colors.orange, sDynamicMax, 50);
        }
    </script>
</body>
</html>
